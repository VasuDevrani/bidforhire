# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bidforhire"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Email (for NextAuth magic link)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@example.com"
EMAIL_SERVER_PASSWORD="your-email-password"
EMAIL_FROM="noreply@bidforhire.com"

# Razorpay
# Key ID is also exposed to the browser via NEXT_PUBLIC_RAZORPAY_KEY_ID
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Pricing (in cents)
MIN_BID_CENTS=100
UNLOCK_PRICE_CENTS=500

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
